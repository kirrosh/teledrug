# Required environment variables
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
OPENAI_API_KEY=your_openai_api_key_here
WEBAPP_URL=https://your-ngrok-miniapp-url.example
NGROK_AUTHTOKEN=your_ngrok_auth_token_here
BOT_HEALTH_SERVER_ENABLED=true
STACK_START_BOT=true
STACK_SKIP_BOT=true
STACK_CONFIRM_BOT_START=true
MINIAPP_PORT=3001

# Database (для Railway используйте ${{ Postgres.DATABASE_URL }})
DATABASE_URL=postgresql://teledrug:teledrug_secret_2024@localhost:5432/teledrug_db

# Encryption
ENCRYPTION_MASTER_KEY=generate_64_character_hex_key_here

# Railway specific variables (автоматически генерируются Railway)
# PORT=3000
# NODE_ENV=production
