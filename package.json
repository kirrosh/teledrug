{
  "name": "teledrug-monorepo",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@ngrok/ngrok": "^1.5.2",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.6",
    "drizzle-orm": "^0.44.7",
    "typescript": "5.9.2"
  },
  "scripts": {
    "prestart": "bun run db:migrate",
    "build": "bun run --filter @teledrug/core build && bun run --filter @teledrug/bot build && bun run --filter @teledrug/daily-greeting build",
    "bot:dev": "bun run --filter @teledrug/bot dev",
    "bot:start": "bun run --filter @teledrug/bot start",
    "digest:send": "bun run --filter @teledrug/daily-greeting start",
    "digest:evening": "bun run --filter @teledrug/daily-greeting start:evening",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "miniapp:dev": "bun run --filter miniapp dev -- --port 3001",
    "miniapp:build": "bun run --filter miniapp build",
    "miniapp:start": "bun run --filter miniapp start",
    "miniapp:stack": "bun run scripts/dev-miniapp-with-bot.ts",
    "google-auth:dev": "bun run --filter @teledrug/google-auth dev",
    "google-auth:build": "bun run --filter @teledrug/google-auth build",
    "google-auth:start": "bun run --filter @teledrug/google-auth start"
  },
  "dependencies": {
    "postgres": "^3.4.7"
  }
}
