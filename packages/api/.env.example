# API Server Configuration
API_PORT=3001
NODE_ENV=development

# API URL (for OAuth callbacks)
# В production: https://your-domain.com
# В development: http://localhost:3001
API_URL=http://localhost:3001

# CORS Origin
# В production: https://your-telegram-webapp.com
# В development: * (для разработки)
CORS_ORIGIN=*

# Google OAuth 2.0 Credentials
# Получить на: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/oauth/google/callback

# PostgreSQL используется для OAuth sessions (из DATABASE_URL)

# Telegram Bot Token (для отправки уведомлений)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Database Configuration (наследуется из основного .env)
# DATABASE_URL=postgresql://user:password@localhost:5432/teledrug

# Encryption Key (наследуется из основного .env)
# ENCRYPTION_KEY=your-32-byte-hex-key
