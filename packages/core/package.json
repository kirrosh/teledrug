{
  "name": "@teledrug/core",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "db:generate": "drizzle-kit generate --config ../../drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ../../drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config ./src/storage/database/drizzle.config.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.32",
    "@effect/platform": "^0.90.10",
    "@effect/platform-node": "^0.96.1",
    "@effect/schema": "^0.75.5",
    "ai": "^5.0.45",
    "drizzle-orm": "^0.44.5",
    "effect": "^3.17.13",
    "grammy": "^1.38.2",
    "postgres": "^3.4.7",
    "tsdav": "^2.1.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4",
    "typescript": "5.9.2"
  }
}
