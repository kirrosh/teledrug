{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "baseUrl": ".",
    "paths": {
      "@teledrug/core/*": ["packages/core/src/*"],
      "@teledrug/core": ["packages/core/src/index.ts"],
      "@teledrug/db/*": ["packages/db/src/*"],
      "@teledrug/db": ["packages/db/src/index.ts"],
      "@teledrug/encryption/*": ["packages/encryption/src/*"],
      "@teledrug/encryption": ["packages/encryption/src/index.ts"],
      "@teledrug/timezone/*": ["packages/timezone/src/*"],
      "@teledrug/timezone": ["packages/timezone/src/index.ts"],
      "@teledrug/og/*": ["packages/og/src/*"],
      "@teledrug/og": ["packages/og/src/index.ts"],
      "@apps/bot/*": ["apps/bot/src/*"],
      "@apps/daily-greeting/*": ["apps/daily-greeting/src/*"]
    }
  }
}
